+VOID OnPaintCover(HWND hwnd, HDC hdc)
+{
+	RECT rc;
+	if (!hdc || FALSE == GetClientRect(hwnd, &rc))
+	{
+		return;
+	}
+	FillRect(hdc, &rc, static_cast<HBRUSH>(GetStockObject(BLACK_BRUSH)));
+	if (g_cover_text.empty())
+	{
+		return;
+	}
+
+	const int w = rc.right - rc.left;
+	const int h = rc.bottom - rc.top;
+	const int px = (std::max)(16, h / 32);
+	HFONT font = CreateFontW(-px, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+		OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_SWISS,
+		L"Microsoft YaHei UI");
+	const HGDIOBJ old = font ? SelectObject(hdc, font) : nullptr;
+	SetBkMode(hdc, TRANSPARENT);
+	SetTextColor(hdc, RGB(0xC8, 0xCC, 0xD2));
+
+	const UINT fmt = DT_CENTER | DT_WORDBREAK | DT_NOPREFIX;
+	RECT text = { rc.left + w / 8, 0, rc.right - w / 8, 0 };
+	DrawTextW(hdc, g_cover_text.c_str(), -1, &text, fmt | DT_CALCRECT);
+	const int tw = text.right - text.left;
+	const int th = text.bottom - text.top;
+	text.left = rc.left + (w - tw) / 2;
+	text.right = text.left + tw;
+	text.top = rc.top + (h - th) / 2;
+	text.bottom = text.top + th;
+	DrawTextW(hdc, g_cover_text.c_str(), -1, &text, fmt);
+
+	if (old)
+	{
+		SelectObject(hdc, old);
+	}
+	if (font)
+	{
+		DeleteObject(font);
+	}
+}
