# Rendered by the nginx image's envsubst into /etc/nginx/conf.d/default.conf
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# download center: never cache the page / latest.json (clients poll it for updates)
map $uri $sd_cache_control {
    ~\.(json|html)$  "no-cache";
    default          "";
}

server {
    listen ${GATEWAY_PORT};
    server_name _;
    server_tokens off;
    charset utf-8;
    charset_types text/html application/json text/plain;

    # hbbs WebSocket (ID registration / punch-hole / online query)
    location /ws/id {
        proxy_pass http://127.0.0.1:21118;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # hbbr WebSocket (relayed remote-desktop sessions)
    location /ws/relay {
        proxy_pass http://127.0.0.1:21119;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # super控制台: RustDesk-compatible API + admin UI
    location /api/ {
        proxy_pass http://127.0.0.1:21120;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 64m;          # session-recording upload chunks
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }
    location /admin {
        proxy_pass http://127.0.0.1:21120;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;               # recording playback streams
    }
    location = / {
        return 302 /admin/;
    }

    # Download center (written by superdesk/scripts/publish.py)
    location /download/ {
        alias /usr/share/superdesk/download/;
        index index.html;
        types {
            text/html html;
            application/json json;
            application/vnd.android.package-archive apk;
            application/octet-stream exe ps1 bat;
        }
        add_header Cache-Control $sd_cache_control;
    }
    location = /download {
        return 301 /download/;
    }

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
