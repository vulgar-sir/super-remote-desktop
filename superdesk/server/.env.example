# Copy to .env (never commit .env)
# Server public IP or domain (what clients connect to)
PUBLIC_HOST=1.2.3.4
# Public TCP port for the gateway (internal port must match the external one)
GATEWAY_PORT=12345

# Relay bandwidth limits in Mb/s -- set TOTAL to ~90% of the server's real bandwidth
RELAY_TOTAL_MBPS=100
RELAY_SINGLE_MBPS=16
RELAY_DOWNGRADED_MBPS=4

# super控制台 first admin (only used when the console database is empty).
# Leave the password empty to generate one into data/console/initial-admin.txt
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=
TZ=Asia/Shanghai
