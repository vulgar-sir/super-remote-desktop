+    // super远程桌面: RegisterPk received over TCP/WebSocket. Same checks as the UDP path; on
+    // success the connection becomes the device's channel for punch-hole/relay requests.
+    async fn handle_tcp_register_pk(
+        &mut self,
+        rk: RegisterPk,
+        sink: &mut Option<Sink>,
+        addr: SocketAddr,
+    ) -> register_pk_response::Result {
+        if rk.uuid.is_empty() || rk.pk.is_empty() || rk.id.len() < 6 {
+            return UUID_MISMATCH;
+        }
+        let id = rk.id;
+        let ip = addr.ip().to_string();
+        if !self.check_ip_blocker(&ip, &id).await {
+            return TOO_FREQUENT;
+        }
+        let peer = self.pm.get_or(&id).await;
+        {
+            let p = peer.read().await;
+            if !p.uuid.is_empty() {
+                if p.uuid != rk.uuid {
+                    log::warn!("Peer {} uuid mismatch (tcp): {:?} vs {:?}", id, rk.uuid, p.uuid);
+                    return UUID_MISMATCH;
+                }
+                if p.info.ip != ip && p.pk != rk.pk {
+                    log::warn!("Peer {} ip/pk mismatch (tcp): {} vs {}", id, ip, p.info.ip);
+                    return UUID_MISMATCH;
+                }
+            }
+        }
+        let res = self.pm.update_pk(id.clone(), peer, addr, rk.uuid, rk.pk, ip).await;
+        if res == register_pk_response::Result::OK {
+            Self::register_tcp_sink(id, sink, addr).await;
+        }
+        res
+    }
