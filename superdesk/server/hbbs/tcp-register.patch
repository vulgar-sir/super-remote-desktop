+    // super远程桌面: move a connection's sink into a writer task fed by a channel, so several
+    // parties (registration heartbeat, punch replies, WebRTC candidates) can write to it.
+    fn spawn_sink_writer(raw: Sink) -> mpsc::UnboundedSender<Option<Bytes>> {
+        if let Sink::Chan(tx) = raw {
+            return tx;
+        }
+        let (tx, mut rx) = mpsc::unbounded_channel::<Option<Bytes>>();
+        tokio::spawn(async move {
+            let mut raw = raw;
+            // None = the reading side is done: close the connection so the device
+            // notices and registers again instead of idling on heartbeats.
+            while let Some(Some(bytes)) = rx.recv().await {
+                let ok = match &mut raw {
+                    Sink::TcpStream(s) => s.send(bytes).await.is_ok(),
+                    Sink::Ws(ws) => ws.send(tungstenite::Message::Binary(bytes.to_vec())).await.is_ok(),
+                    Sink::Chan(c) => c.send(Some(bytes)).is_ok(),
+                };
+                if !ok {
+                    break;
+                }
+            }
+            match &mut raw {
+                Sink::TcpStream(s) => { s.close().await.ok(); }
+                Sink::Ws(ws) => { ws.close().await.ok(); }
+                Sink::Chan(_) => {}
+            }
+        });
+        tx
+    }
+
+    // super远程桌面: writer of controller connection `addr` for WebRTC signalling. The punch
+    // reply normally takes the controller's sink and drops it; once the reply carries a WebRTC
+    // answer (or a candidate arrives first) the sink moves behind a channel kept in ICE_ROUTE,
+    // so the trickled ICE candidates that follow can still reach the controller.
+    async fn ice_route(&self, addr: SocketAddr) -> Option<mpsc::UnboundedSender<Option<Bytes>>> {
+        let addr = try_into_v4(addr);
+        let mut routes = ICE_ROUTE.lock().await;
+        if let Some(tx) = routes.get(&addr) {
+            return Some(tx.clone());
+        }
+        let mut punch = self.tcp_punch.lock().await;
+        let tx = Self::spawn_sink_writer(punch.remove(&addr)?);
+        punch.insert(addr, Sink::Chan(tx.clone()));
+        routes.insert(addr, tx.clone());
+        Some(tx)
+    }
+
+    // super远程桌面: trickled WebRTC ICE candidate. From the controlled device (socket_addr =
+    // the controller's punch connection) or from the controller (id = the controlled device).
+    async fn handle_ice_candidate(&mut self, mut ice: IceCandidate, addr: SocketAddr) {
+        if ice.session_key.is_empty() || ice.candidate.is_empty() || ice.candidate.len() > MAX_ICE_CANDIDATE_LEN {
+            return;
+        }
+        let mut msg_out = RendezvousMessage::new();
+        if !ice.socket_addr.is_empty() {
+            let addr_a = AddrMangle::decode(&ice.socket_addr);
+            if let Some(tx) = self.ice_route(addr_a).await {
+                ice.socket_addr = Default::default();
+                msg_out.set_ice_candidate(ice);
+                if let Ok(bytes) = msg_out.write_to_bytes() {
+                    tx.send(Some(Bytes::from(bytes))).ok();
+                }
+            }
+        } else if let Some(peer) = self.pm.get_in_memory(&ice.id).await {
+            ice.socket_addr = AddrMangle::encode(addr).into();
+            msg_out.set_ice_candidate(ice);
+            let peer_addr = peer.read().await.socket_addr;
+            self.tx.send(Data::Msg(msg_out.into(), peer_addr)).ok();
+        }
+    }
+
+    async fn register_tcp_sink(id: String, sink: &mut Option<Sink>, addr: SocketAddr) {
+        let tx = match sink.take() {
+            Some(Sink::Chan(tx)) => tx,
+            Some(raw) => {
+                let tx = Self::spawn_sink_writer(raw);
+                // Heartbeat: the client echoes empty frames, which keeps the device online and
+                // makes a dead connection fail the next write.
+                let hb = tx.clone();
+                tokio::spawn(async move {
+                    let mut t = interval(Duration::from_secs(TCP_REG_HEARTBEAT_SECS));
+                    t.tick().await;
+                    loop {
+                        t.tick().await;
+                        if hb.send(Some(Bytes::new())).is_err() {
+                            break;
+                        }
+                    }
+                });
+                tx
+            }
+            None => return,
+        };
+        *sink = Some(Sink::Chan(tx.clone()));
+        log::info!("Peer {} registered over tcp/ws from {:?}", id, addr);
+        let mut reg = TCP_REG.lock().await;
+        reg.retain(|_, v| v.0 != id);
+        reg.insert(try_into_v4(addr), (id, tx));
     }
 
